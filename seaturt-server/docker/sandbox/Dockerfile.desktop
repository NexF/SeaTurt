# ===== Stage 1: Build MCP servers =====
FROM golang:1.23-alpine AS builder

WORKDIR /build/core
COPY mcp-servers/core/ ./
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /mcp-server-core .

WORKDIR /build/desktop
COPY mcp-servers/desktop/ ./
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /mcp-server-desktop .

# ===== Stage 2: Runtime image with desktop =====
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Basic tools (same as base image)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git vim nano \
    python3 python3-pip \
    build-essential \
    jq tree ripgrep \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Xvfb virtual display
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# GNOME minimal desktop
RUN apt-get update && apt-get install -y --no-install-recommends \
    gnome-session \
    gnome-terminal \
    gnome-shell \
    gnome-settings-daemon \
    gnome-control-center \
    dbus-x11 \
    x11-xserver-utils \
    x11-utils \
    xdotool \
    wmctrl \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# TigerVNC + noVNC
RUN apt-get update && apt-get install -y --no-install-recommends \
    tigervnc-standalone-server \
    tigervnc-common \
    novnc \
    websockify \
    && rm -rf /var/lib/apt/lists/*

# Firefox browser
RUN apt-get update && apt-get install -y --no-install-recommends \
    firefox \
    && rm -rf /var/lib/apt/lists/*

# Screenshot tools (scrot + ImageMagick)
RUN apt-get update && apt-get install -y --no-install-recommends \
    scrot \
    imagemagick \
    && rm -rf /var/lib/apt/lists/*

# Install MCP servers
COPY --from=builder /mcp-server-core /usr/local/bin/mcp-server-core
COPY --from=builder /mcp-server-desktop /usr/local/bin/mcp-server-desktop
RUN chmod +x /usr/local/bin/mcp-server-core /usr/local/bin/mcp-server-desktop

# Install gosu and sudo
RUN apt-get update && apt-get install -y --no-install-recommends gosu sudo && rm -rf /var/lib/apt/lists/*

# Create default agent user with passwordless sudo
RUN useradd -m -s /bin/bash agent \
    && echo "agent ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/agent \
    && chmod 0440 /etc/sudoers.d/agent

# Desktop startup script
COPY start-desktop.sh /usr/local/bin/start-desktop.sh
RUN chmod +x /usr/local/bin/start-desktop.sh

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace

# Expose VNC and noVNC ports
EXPOSE 5900 6080

ENTRYPOINT ["/entrypoint.sh"]
CMD ["tail", "-f", "/dev/null"]
