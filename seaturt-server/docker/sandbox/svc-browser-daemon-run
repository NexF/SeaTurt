#!/usr/bin/with-contenv bash

# s6 service: browser MCP daemon
# Waits for desktop environment (X11 DISPLAY=:1) then starts the Node.js daemon.
#
# Code location: /workspace/.seaturt/mcp-servers/browser/ (per-agent, editable).
# npm deps (@playwright/mcp, chromium) are globally installed in the Docker image.

# Wait for desktop to be ready (same pattern as svc-selkies-run)
until [ -f /defaults/pid ]; do
  sleep .5
done

export DISPLAY=:1
export BROWSER_USER_DATA_DIR="/workspace/.seaturt/mcp-servers/browser/user-data"

# Ensure user data directory exists (persisted via workspace bind mount)
mkdir -p /workspace/.seaturt/mcp-servers/browser/user-data

# exec replaces this shell with node — s6 manages the node process directly
# (signal forwarding, automatic restart on crash)
exec node /workspace/.seaturt/mcp-servers/browser/server.js
